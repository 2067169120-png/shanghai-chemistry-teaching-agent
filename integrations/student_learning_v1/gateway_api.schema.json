{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.sh-chem-db/schema/gateway_student_learning_api_v1.json",
  "title": "Gateway student learning JSON envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "ok", "code", "error", "data"],
  "properties": {
    "api_version": {"const": "gateway_student_learning_api_v1"},
    "ok": {"type": "boolean"},
    "code": {"enum": [0, 10, 11, 12, 13, 14, 15, 16, 17, 50]},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message"],
          "properties": {"type": {"type": "string"}, "message": {"type": "string"}}
        }
      ]
    },
    "data": {"type": ["object", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"ok": {"const": true}}}, "then": {"properties": {"code": {"const": 0}, "error": {"type": "null"}, "data": {"type": "object"}}}},
    {"if": {"properties": {"ok": {"const": false}}}, "then": {"properties": {"code": {"not": {"const": 0}}, "error": {"type": "object"}, "data": {"type": "null"}}}}
  ]
}
