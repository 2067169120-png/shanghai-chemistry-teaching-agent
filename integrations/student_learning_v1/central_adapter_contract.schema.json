{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.sh-chem.invalid/student_learning_v1/central_diagnosis_adapter_v2.json",
  "title": "Controller-issued live diagnosis receipt v2 compatibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "controller_contract_version", "controller_version", "receipt_type", "profile_id", "input_sha256", "allowed", "live_central_state_used", "registry_binding", "validated_attempts", "blockers", "machine_status", "human_reviewed", "receipt_sha256"],
  "properties": {
    "contract_version": {"const": "central_diagnosis_adapter_v2"},
    "controller_contract_version": {"const": "2.0.0"},
    "controller_version": {"const": "2.0.0-machine-only"},
    "receipt_type": {"const": "controller_issued_live_registry_binding"},
    "profile_id": {"type": "string", "format": "uuid"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed": {"const": true},
    "live_central_state_used": {"const": true},
    "registry_binding": {"$ref": "#/$defs/file_ref"},
    "validated_attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "question_id", "atomic_part_id", "evidence_sha256", "canonical_parent_chain_sha256", "governance_chain", "governance_state", "subject_pair_sha256", "allowed", "blockers"],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "question_id": {"type": "string", "minLength": 1},
          "atomic_part_id": {"type": "string", "minLength": 1},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "canonical_parent_chain_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "governance_chain": {"$ref": "#/$defs/file_ref"},
          "governance_state": {"const": "automated_verified_candidate"},
          "subject_pair_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "allowed": {"const": true},
          "blockers": {"type": "array", "maxItems": 0}
        }
      }
    },
    "blockers": {"type": "array", "maxItems": 0},
    "machine_status": {"const": "machine_only_not_human_reviewed"},
    "human_reviewed": {"const": false},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
