{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/shchem-generation-v2/review-receipt.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "context_id", "role", "model", "reasoning_effort", "paper_sha256", "task_card_sha256", "visible_context_kinds", "findings", "disposition", "human_review_claimed"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "context_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["generator", "independent_machine_review", "adversarial_check"]},
    "model": {"const": "gpt-5.6-sol"},
    "reasoning_effort": {"const": "xhigh"},
    "paper_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "visible_context_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "disposition": {"enum": ["pass", "fail"]},
    "human_review_claimed": {"const": false}
  }
}

