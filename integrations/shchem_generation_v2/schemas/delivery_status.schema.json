{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.sh-chem.invalid/generation_v2/external-delivery-status.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "promotion_path", "promotion_sha256", "promotion_bytes",
    "candidate_sha256", "task_card_sha256", "manifest_path", "manifest_sha256",
    "archive_path", "archive_sha256", "archive_bytes", "content_governance_sha256",
    "teacher_managed_delivery_candidate", "delivery_scope", "teacher_action_required",
    "human_reviewed", "teaching_use_allowed", "official_claim_allowed",
    "official_publication_allowed", "external_publication_allowed", "publication_allowed",
    "release_allowed"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "external_teacher_managed_delivery_status"},
    "promotion_path": {"$ref": "#/$defs/relpath"},
    "promotion_sha256": {"$ref": "#/$defs/sha256"},
    "promotion_bytes": {"type": "integer", "minimum": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "task_card_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_path": {"$ref": "#/$defs/relpath"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "archive_path": {"$ref": "#/$defs/relpath"},
    "archive_sha256": {"$ref": "#/$defs/sha256"},
    "archive_bytes": {"type": "integer", "minimum": 1},
    "content_governance_sha256": {"$ref": "#/$defs/sha256"},
    "teacher_managed_delivery_candidate": {"const": true},
    "delivery_scope": {"const": "teacher_managed_private_delivery"},
    "teacher_action_required": {"const": true},
    "human_reviewed": {"const": false},
    "teaching_use_allowed": {"const": false},
    "official_claim_allowed": {"const": false},
    "official_publication_allowed": {"const": false},
    "external_publication_allowed": {"const": false},
    "publication_allowed": {"const": false},
    "release_allowed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relpath": {"type": "string", "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"}
  }
}
