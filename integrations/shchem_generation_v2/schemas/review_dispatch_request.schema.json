{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.sh-chem.invalid/generation_v2/review_dispatch_request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "dispatch_id", "version_id", "paper_id",
    "generator_thread_id", "root_dispatch_id", "immutable_inputs", "schemas",
    "prompts", "requested_tasks", "independence_contract", "coverage_contract",
    "self_hash_contract", "post_return_action", "controller_registration_requested",
    "publication_requested", "human_reviewed", "official_claim_allowed"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "independent_review_dispatch_request"},
    "dispatch_id": {"type": "string", "minLength": 8},
    "version_id": {"type": "string", "pattern": "-R[0-9]+$"},
    "paper_id": {"type": "string", "pattern": "-[0-9]{3}$"},
    "generator_thread_id": {"type": "string", "format": "uuid"},
    "root_dispatch_id": {"type": "string", "format": "uuid"},
    "immutable_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper", "task_card", "question_subject", "answer_subject", "deterministic_request", "deterministic_report", "coverage_matrix", "figure_svg", "figure_png", "figure_spec"],
      "properties": {
        "paper": {"$ref": "#/$defs/file_ref"},
        "task_card": {"$ref": "#/$defs/file_ref"},
        "question_subject": {"$ref": "#/$defs/file_ref"},
        "answer_subject": {"$ref": "#/$defs/file_ref"},
        "deterministic_request": {"$ref": "#/$defs/file_ref"},
        "deterministic_report": {"$ref": "#/$defs/file_ref"},
        "coverage_matrix": {"$ref": "#/$defs/file_ref"},
        "figure_svg": {"$ref": "#/$defs/file_ref"},
        "figure_png": {"$ref": "#/$defs/file_ref"},
        "figure_spec": {"$ref": "#/$defs/file_ref"}
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine_review_record", "adversarial_check_record"],
      "properties": {
        "machine_review_record": {"$ref": "#/$defs/file_ref"},
        "adversarial_check_record": {"$ref": "#/$defs/file_ref"}
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sol_review_a", "sol_review_b", "adversarial"],
      "properties": {
        "sol_review_a": {"$ref": "#/$defs/file_ref"},
        "sol_review_b": {"$ref": "#/$defs/file_ref"},
        "adversarial": {"$ref": "#/$defs/file_ref"}
      }
    },
    "requested_tasks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "object"}
    },
    "independence_contract": {
      "type": "object",
      "required": ["required_engine", "required_reasoning_effort", "distinct_non_generator_thread_count", "run_id_only_is_not_isolation", "generation_task_may_validate_but_must_not_author_or_modify_receipts"],
      "properties": {
        "required_engine": {"const": "gpt-5.6-sol"},
        "required_reasoning_effort": {"const": "xhigh"},
        "distinct_non_generator_thread_count": {"const": 3},
        "run_id_only_is_not_isolation": {"const": true},
        "generation_task_may_validate_but_must_not_author_or_modify_receipts": {"const": true}
      }
    },
    "coverage_contract": {
      "type": "object",
      "required": ["expected_atomic_part_ids", "review_finding_count_each", "adversarial_item_coverage_count", "coverage_matrix_review_required"],
      "properties": {
        "expected_atomic_part_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]+$"}},
        "review_finding_count_each": {"type": "integer", "minimum": 1},
        "adversarial_item_coverage_count": {"type": "integer", "minimum": 1},
        "coverage_matrix_review_required": {"const": true}
      }
    },
    "self_hash_contract": {"type": "object"},
    "post_return_action": {"type": "string", "minLength": 1},
    "controller_registration_requested": {"const": false},
    "publication_requested": {"const": false},
    "human_reviewed": {"const": false},
    "official_claim_allowed": {"const": false}
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
