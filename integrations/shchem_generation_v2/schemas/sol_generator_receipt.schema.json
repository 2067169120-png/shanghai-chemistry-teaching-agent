{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/shchem-generation-v2/sol-generator-receipt.json",
  "title": "Hash- and provenance-bound Sol generator receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "receipt_id",
    "version_id",
    "paper_id",
    "provenance_status",
    "execution_provenance",
    "schema_binding",
    "paper",
    "task_card",
    "subject",
    "deterministic_check",
    "producer_fingerprint",
    "regeneration_id",
    "content_scope",
    "output_sha256",
    "human_reviewed",
    "teaching_use_allowed",
    "publication_allowed"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "sol_generator_receipt"},
    "receipt_id": {"type": "string", "minLength": 8},
    "version_id": {"type": "string", "minLength": 1},
    "paper_id": {"type": "string", "minLength": 1},
    "provenance_status": {"const": "self_reported"},
    "execution_provenance": {"$ref": "#/$defs/execution_provenance"},
    "schema_binding": {"$ref": "#/$defs/file_ref"},
    "paper": {"$ref": "#/$defs/file_ref"},
    "task_card": {"$ref": "#/$defs/file_ref"},
    "subject": {"$ref": "#/$defs/subject"},
    "deterministic_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "report"],
      "properties": {
        "request": {"$ref": "#/$defs/file_ref"},
        "report": {"$ref": "#/$defs/file_ref"}
      }
    },
    "producer_fingerprint": {
      "type": "object",
      "required": ["producer_version_id", "algorithm", "source_file_count", "source_tree_sha256", "files"],
      "properties": {
        "producer_version_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "canonical-sha256-of-sorted-owned-producer-files-v1"},
        "source_file_count": {"type": "integer", "minimum": 1},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_ref"}}
      }
    },
    "regeneration_id": {"type": "string", "minLength": 8},
    "content_scope": {"const": "prefreeze_original_candidate_generation"},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "human_reviewed": {"const": false},
    "teaching_use_allowed": {"const": false},
    "publication_allowed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relpath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer", "subject_pair_sha256"],
      "properties": {
        "question": {"$ref": "#/$defs/file_ref"},
        "answer": {"$ref": "#/$defs/file_ref"},
        "subject_pair_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "thread_id", "turn_id", "receipt_id", "model", "reasoning_effort", "root_dispatch_id"],
      "properties": {
        "provider": {"const": "codex_app_thread"},
        "thread_id": {"type": "string", "format": "uuid"},
        "turn_id": {"type": "string", "minLength": 1},
        "receipt_id": {"type": "string", "minLength": 1},
        "model": {"const": "gpt-5.6-sol"},
        "reasoning_effort": {"const": "xhigh"},
        "root_dispatch_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
