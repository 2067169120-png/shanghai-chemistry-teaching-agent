{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/shchem-generation-v2/component-registry.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "source_registry", "source_registry_sha256", "component_count", "searchable", "claim_boundary", "components", "human_reviewed", "publication_allowed"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "source_registry": {"type": "string", "minLength": 1},
    "source_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component_count": {"type": "integer", "minimum": 25},
    "searchable": {"const": true},
    "claim_boundary": {"type": "string", "minLength": 10},
    "components": {
      "type": "array",
      "minItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "name", "aliases", "search_keywords", "status", "evidence_refs", "direct_pixel_reuse_allowed", "independent_redraw_required", "human_reviewed", "publication_allowed"],
        "properties": {
          "component_id": {"type": "string", "pattern": "^M2-"},
          "name": {"type": "string", "minLength": 2},
          "aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "search_keywords": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "status": {"enum": ["searchable_internal_evidence_only", "independent_svg_component_machine_checked"]},
          "evidence_refs": {"type": "array"},
          "authored_asset_ref": {"type": "string"},
          "direct_pixel_reuse_allowed": {"const": false},
          "independent_redraw_required": {"type": "boolean"},
          "human_reviewed": {"const": false},
          "publication_allowed": {"const": false}
        }
      }
    },
    "human_reviewed": {"const": false},
    "publication_allowed": {"const": false}
  }
}
