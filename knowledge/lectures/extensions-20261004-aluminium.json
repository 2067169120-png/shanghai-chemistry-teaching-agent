  "entries": [
    {
      "package_id": "PKG-054",
      "source_sha256": "29a257401b339a157448bf1873d80e99222072af73fd2c9900097151192b97f3",
      "source_preview_revision": "d2a6439330b24b4777fb1852c1dfb559f235ff4a7fd0dd745e04cec35550963b",
      "source_extraction_revision": "20260909-editable-chemistry-v2",
      "knowledge": [
        {
          "summary": "金属铝与碱水溶液放氢气属于氧化还原；氧化铝、氢氧化铝的两性反应不能据此也写出氢气。先确定起始物是Al、Al₂O₃还是Al(OH)₃，再核水、酸碱条件和铝的价态，避免把三种物质的反应混用。",
          "block_indices": [
            35,
            65,
            69,
            71,
            74
          ]
        },
        {
          "summary": "Al³⁺＋3OH⁻→Al(OH)₃↓，继续加1mol OH⁻可使1mol沉淀转为[Al(OH)₄]⁻。反向由四羟基合铝酸根加酸，先耗1mol H⁺析出沉淀，再耗3mol H⁺溶解；铝离子、氢氧化铝、氢氧根和氢离子的用量必须按起始物及加入顺序分段。",
          "block_indices": [
            155,
            159,
            160,
            161,
            162,
            164,
            165
          ]
        },
        {
          "summary": "在讲义给定Al/Fe分离流程中，足量强碱可使铝进入可溶铝酸盐而保留铁的相应固相；氨水则可能同时沉淀Al³⁺、Fe³⁺，不能直接完成同样分离。应按实际共存物和滤液、滤渣身份判断，不把“都能生成氢氧化物”当作选择性分离依据。",
          "block_indices": [
            264,
            268,
            285,
            287,
            291,
            293,
            298
          ]
        },
        {
          "summary": "铝土矿采用酸浸或碱浸时，硅、铝及铁的去向不同。讲义酸浸实例保留SiO₂在滤渣；碱浸实例又涉及硅酸盐进入液相。先读原料给定组成与各步试剂，再判断杂质去除环节，不能套用一种“铝土矿必然流程”。",
          "block_indices": [
            256,
            257,
            259,
            264,
            285,
            291,
            298
          ]
        }
      ],
      "methods": [
        {
          "summary": "读沉淀曲线先标横轴加入的是酸或碱、加入方向、初始铝物种与共存离子，再逐段标反应和终点。平台、斜率或同一沉淀量可以对应不同反应阶段；含Mg²⁺等其他离子时不能把全部沉淀量和全部OH⁻消耗都归给铝。",
          "block_indices": [
            179,
            180,
            182,
            186,
            188,
            195,
            199,
            200,
            218,
            225,
            228,
            232,
            238,
            246
          ]
        },
        {
          "summary": "纯铝盐、无其他耗碱物种的限定模型中，沉淀生成段n[Al(OH)₃]=n(OH⁻)/3；再溶解段为4n(初始Al³⁺)−n(OH⁻)。已知相同沉淀量仍须核所在区段；若含酸或Mg²⁺等离子，先扣除其他耗碱量，再用cV和统一单位计算。",
          "block_indices": [
            159,
            165,
            195,
            199,
            200,
            223,
            225
          ]
        },
        {
          "summary": "流程分析按元素逐步记录输入、反应、固液分离及循环。每次过滤分别列滤液、滤渣中的目标元素与杂质，再用元素、电荷和试剂余量核下一步；沉淀、灼烧、电解的条件不同，不能省略水相到固态、熔融态的转换。",
          "block_indices": [
            256,
            257,
            259,
            264,
            268,
            272,
            285,
            287,
            291,
            298,
            308,
            314
          ]
        },
        {
          "summary": "铝热产物的Fe₂O₃检验不能只看酸溶后KSCN是否显红。氧化铁可生成Fe³⁺，共存Fe又可发生2Fe³⁺＋Fe→3Fe²⁺（铁离子、铁、亚铁离子），改变检验对象；阴性现象须考虑前处理和共存还原剂，不据此否定原样含氧化铁。",
          "block_indices": [
            108,
            120,
            126
          ]
        }
      ],
      "pitfalls": [
        {
          "summary": "讲义195将生成段写成n[Al(OH)₃]=n(OH⁻)，漏掉除以3；159的配平式及199的用量关系提供相反证据。原文保留，候选提示按每1mol铝离子需3mol氢氧根核算，不把印刷公式直接当作正确计算模型。",
          "block_indices": [
            159,
            195,
            199,
            200
          ]
        },
        {
          "summary": "讲义131和134的管道疏通式在[Al(OH)₄]⁻前漏系数2，铝和电荷都不守恒，却把该选项判为正确。应为2Al＋2OH⁻＋6H₂O→2[Al(OH)₄]⁻＋3H₂↑（铝、氢氧根、水、四羟基合铝酸根、氢气）；原选择答案因此另留复核，不能只改公式后沿用答案。",
          "block_indices": [
            35,
            131,
            134
          ]
        },
        {
          "summary": "讲义120、126对铝热产物酸溶及铁的还原写错Fe价态，甚至写成Fe²⁺被还原为Fe²⁺。应区分氧化铁酸溶所得Fe³⁺、共存铁消耗Fe³⁺及KSCN所检物种；结论“阴性不能否定原样氧化铁”不代表这些错误反应说明可以沿用。",
          "block_indices": [
            108,
            120,
            126
          ]
        },
        {
          "summary": "讲义225写V₁=0.16L=1600mL，单位换算应为160mL，与223的答案160也一致。该题仍有部分旧公式不可读，当前只能确认此单位冲突，不能宣称全部图像计算和原答案已核验。",
          "block_indices": [
            218,
            223,
            224,
            225
          ]
        },
        {
          "summary": "讲义80把Al₂O₃、Al(OH)₃称为中学唯一能与碱反应的金属氧化物、氢氧化物，范围过于绝对；本次教材原页只据反应说明其两性，不以“唯一”作为知识结论，也不由考纲范围推断其他物质不可能反应。",
          "block_indices": [
            65,
            69,
            71,
            74,
            80
          ]
        },
        {
          "summary": "讲义85—89的AlCl₃熔化、晶体、二聚体及配位表述涉及物态和条件，本次金属章节原页未完整核实这些细节。保留工业用熔融Al₂O₃与冰晶石的教材证据；不把AlCl₃在所有条件下的晶体类型、导电性或水溶液物种直接确认为通则。",
          "block_indices": [
            60,
            85,
            86,
            87,
            88,
            89
          ]
        },
        {
          "summary": "讲义262仅凭SiO₂熔点断言不影响电解铝纯度，依据不足；306、314的Ga/Al选择性沉淀解释需限定pH、CO₂量和物种，不能只按同族类比推广，314还把碱浸NaOH误写GaN溶液。当前保留流程阅读与原文，不确认这些工艺断言或缺失的GaN旧公式。",
          "block_indices": [
            262,
            306,
            308,
            310,
            311,
            314
          ]
        }
      ],
      "teaching_flow": [
        {
          "summary": "建议40分钟：5分钟从教材密度、导电性与材料用途提出比较；10分钟区分氧化膜、钝化及去膜后与水反应条件；10分钟比较铝的酸、碱反应并核氢气与守恒；10分钟对照铝热与熔融氧化铝电解；5分钟写出条件、证据和仍待核的物态信息。时间为备课建议。",
          "block_indices": [
