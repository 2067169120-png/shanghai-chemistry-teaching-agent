      "package_id": "PKG-042",
      "knowledge": [
        {
          "summary": "辨认键的变化须先区分物质和过程：共价分子汽化通常改变分子间作用；可溶性离子化合物溶于水可使离子分离。NaOH（氢氧化钠）等含多原子离子，不能把离子键与离子内部共价键混为一谈。",
          "block_indices": [
            89,
            95,
            104,
            106,
            109,
            145,
            149
          ]
        },
        {
          "summary": "σ键沿核间连线形成轴对称重叠，π键由轨道侧向重叠形成；p轨道既可参与σ键也可参与π键。N₂（氮气）的局域三键含1个σ键和2个π键，不能凭“p轨道”三个字判断键型。",
          "block_indices": [
            171,
            173,
            183,
            184,
            186,
            250
          ]
        }
      ],
      "methods": [
        {
          "summary": "电子式先核对总价电子数和粒子电荷，再分配成键与孤电子对；离子须核对括号、电荷和转移方向。CH₃⁺（甲基正离子）碳周围仅6个电子，是讲义的例外练习，不能机械套用8电子。",
          "block_indices": [
            64,
            66,
            80
          ]
        },
        {
          "summary": "局域结构中的σ/π计数先画完整连接、补氢，再逐键计数并乘以粒子数。CO(NH₂)₂（尿素）结构中有7个σ键和1个π键；不要把官能团数当作π键数，也不要把离子间作用算作σ键。",
          "block_indices": [
            150,
            151,
            152,
            153,
            154,
            155,
            183,
            184,
            185,
            186
          ]
        },
        {
          "summary": "用键能估算反应焓变先写并配平反应式，核对物态及每种键的数量，再取断键吸热减成键放热。平均键能所得是估算；若涉及液体汽化等过程，应另核对相变焓，不能只套气态键能表。",
          "block_indices": [
            202,
            207,
            209,
            295,
            298,
            299,
            301
          ]
        }
      ],
      "pitfalls": [
        {
          "summary": "同种成键原子的常见局域单、双、三键可作有条件的比较，双键或三键的键能不必等于单键的2倍或3倍。跨不同成键原子不能仅由键长推出键能、沸点或全部反应活性。",
          "block_indices": [
            202,
            208,
            211,
            212,
            281,
            283,
            301,
            314
          ]
        },
        {
          "summary": "平面结构式给出连接关系，不直接给出三维构型：H—O—H（水）不能因此判成直线，P₄（白磷）与CH₄（甲烷）的四面体语境和键角也不同。讨论键角要明确中心原子及孤电子对。",
          "block_indices": [
            224,
            225,
            227,
            228,
            279,
            283,
            325,
            331,
            337
          ]
        },
        {
          "summary": "键极性、分子极性、键的断裂能和反应活性是不同判断；不把讲义中“键越极性越易断裂”当通则。需核对具体反应物、条件、生成物及动力学证据，教材的键参数比较也有适用范围。",
          "block_indices": [
            188,
            190,
            191,
            193,
            194,
            199,
            202,
            208
          ]
        }
      ],
      "teaching_flow": [
        {
          "summary": "建议40分钟：5分钟比较NaCl（氯化钠）与HCl（氯化氢）的成键微粒；10分钟把NaOH（氢氧化钠）等多原子离子化合物画成电子式并互查电荷；15分钟用讲义含键判断题区分化合物类别与键类别；10分钟解释汽化、溶解时的作用变化，笔记同时写过程条件和反例。",
          "block_indices": [
            38,
