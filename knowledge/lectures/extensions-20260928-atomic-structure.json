      "source_extraction_revision": "20260909-editable-chemistry-v2",
      "knowledge": [
        {
          "summary": "能量量子化表示允许的能量取值分立，不表示任意相邻能级间隔都相等。在氢原子的教材模型中，束缚态以有限正整数n编号，n增大时能级逐渐密集；n→∞表示趋近电离极限，∞不是一个正整数，也不是“最高的束缚轨道”。",
          "block_indices": [
            32,
            34,
            36
          ]
        }
      ],
      "methods": [
        {
          "summary": "电子排布题先列计数口径：总电子数、占据的空间轨道数、未成对电子数、占据的nℓ亚层数和最大n层电子数。按泡利原理与洪特规则读基态Mn的[Ar]3d⁵4s²和Fe的[Ar]3d⁶4s²，分别得到25/26、15/15、5/4、7/7、2/2；“7个亚层标签”不能直接改称任意条件下7个精确能量值。",
          "block_indices": [
            64,
            70,
            95,
            99
          ]
        },
        {
          "summary": "先数电子再判粒子和状态：硫题四式[Ne]3s²3p⁴、[Ne]3s²3p²、[Ne]3s²3p²4s¹、[Ne]3s²3p³4s¹各有16、14、15、16个电子，对应S、S²⁺、S⁺、S。后两式含被提升至4s的电子，应与相同电荷粒子的基态排布比较；不能把四式都当成中性硫，也不能只靠电荷数给出精确失电子能量。",
          "block_indices": [
            91,
            92
          ]
        },
        {
          "summary": "光子计算先定初、末能态，再用E光子=hν=hc/λ。发射时原子ΔE=E末−E初<0，而光子能量取其绝对值；吸收时原子能量增加。将nm换成m后，410.1、434.1、486.1、656.3 nm四线的单光子能量约为4.84、4.58、4.09、3.03×10⁻¹⁹ J；同一模型中能级差越大，波长越短。",
          "block_indices": [
            34,
            45,
            175
          ]
        },
        {
          "summary": "识别光谱实验时分清四步：发光或选择性吸收产生待测光，狭缝限定入射光束，棱镜或光栅按波长分光，接收器记录谱线。源图为氢放电管直接发光后分光，观察发射谱；吸收谱需考查连续光通过气态原子的装置条件。线的位置用于元素识别，强度或吸收量的定量解释还需相应实验条件。",
          "block_indices": [
            162,
            172,
            231,
            233,
            235
          ]
        }
      ],
      "pitfalls": [
        {
          "summary": "概率密度和概率不能混写。若轮廓约定包围90%的总概率，90%描述该空间区域内概率的总和，不是“概率密度为90%”；轮廓外仍可有非零概率。电子云的疏密表示单位体积内出现机会的差异；原子轨道表示空间状态，不能简单等同为伸展方向或电子的确定运动路径。",
          "block_indices": [
            60,
            62,
            63,
            147,
            151
          ]
        },
        {
          "summary": "发射光不要求电子每次都回到基态。教材氢原子可见线的3、4、5、6→2跃迁，末态n=2仍是激发态；一般应说从较高能态跃迁到较低能态并辐射。源图只画“基态↔激发态”可作简例，不能将它扩成全部原子发射过程，也不能据此解释所有霓虹可见谱线。",
          "block_indices": [
            45,
            173,
            175,
            176,
            206,
            234
          ]
        },
        {
          "summary": "构造顺序是书写基态排布的经验工具，具体排布以实验为准。不能把Mn中构造顺序后填3d直接改写为一切情境下3d轨道能量均高于4s，也不能由半满、全满直接推出不同原子、离子或不同电子数体系的绝对稳定次序。比较时须说明对象，并区分轨道能量与整个原子的总能量。",
          "block_indices": [
            70,
            74,
            75,
            76,
            83
          ]
        }
      ],
      "teaching_flow": [
        {
          "summary": "40分钟：0—6分钟比较玻尔圆轨道与电子云；6—14分钟用氢同n简并和多电子亚层排序练习补充条件；14—24分钟给Mn、Fe画占据表并区分五种计数；24—32分钟数硫四式的电子、标电荷和激发；32—40分钟修订“概率密度90%”“半满必更稳定”等断言，提交带模型条件的解释。",
          "block_indices": [
            31,
            32,
            40,
            41,
            42,
            44,
            48,
            51,
            58,
            60,
            62,
