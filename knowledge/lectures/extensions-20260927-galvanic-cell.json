          ]
        }
      ],
      "pitfalls": [
        {
          "summary": "讲义40和52把双液电池写成“只转化为电能、避免能量损耗”，表述过强。39图分开锌与Cu²⁺，可减少直接接触反应；这并不能证明实际输出电能等于全部反应释放的能量。教材印刷89—90页对比温升与外电路电流，95页也给燃料电池效率范围；应区分能量转化方式、旁路反应与装置损耗，不把盐桥当作100%效率保证。",
          "block_indices": [
            36,
            38,
            39,
            40,
            41,
