      "source_extraction_revision": "20260909-editable-chemistry-v2",
      "knowledge": [
        {
          "summary": "葡萄糖与果糖同为C₆H₁₂O₆，链状式分别显示多羟基醛和多羟基酮，不能据同分子式称同系物。教材还说明溶液中葡萄糖主要为环状、环链可转化，果糖在碱性检验条件下可异构化；不能由链状式不含醛基便断言果糖银镜阴性。",
          "block_indices": [
            48,
            53,
            54,
            57,
            62,
            87,
            92
          ]
        },
        {
          "summary": "糖类按水解能力区分单糖、二糖和多糖；甜味或Cₘ(H₂O)ₙ表示式都不能单独定义糖类。蔗糖水解得到葡萄糖与果糖，麦芽糖得到两份葡萄糖；淀粉、纤维素是多糖，充分水解最终得到葡萄糖，不能把中间过程都等同于一步完全水解。",
          "block_indices": [
            41,
            42,
            43,
            44,
            59,
            61,
            65,
            66,
            88
          ]
        },
        {
          "summary": "淀粉检验与还原性水解产物检验分别取样：碘检验在冷却且不受强碱干扰的条件下观察；另一份先中和水解用酸并按检验要求调成碱性，再用银氨或新制Cu(OH)₂并按要求加热。阳性说明有相应可检物，不由一个阴性直接判水解程度。",
          "block_indices": [
            73,
            75,
            77,
            79,
            80,
            148,
            169,
            178,
            180,
            202
          ]
        },
        {
          "summary": "油脂是高级脂肪酸与甘油形成的三酯，甘油为HOCH₂CH(OH)CH₂OH／C₃H₈O₃。三酯中的三个脂肪酸残基可相同或不同，均含三个酯基；不能将残基是否相同与只酯化一个羟基混用，也不能把油脂视为天然高分子。",
          "block_indices": [
            229,
            231,
            232,
            233,
            234,
            242,
            248,
            250,
            269,
            302
          ]
        },
        {
          "summary": "油脂酸性水解生成高级脂肪酸和甘油；碱性水解生成高级脂肪酸盐和甘油，称皂化。含C=C的油脂还可催化加氢提高饱和度，酯基仍在。是否有双键必须看具体结构，饱和硬脂酸甘油酯是讲义和教材中的反例。",
          "block_indices": [
            248,
            250,
            252,
            254,
            259,
            270,
            303
          ]
        }
      ],
      "methods": [
        {
          "summary": "用两条证据链判断淀粉水解：先列残余淀粉的碘检验条件，再列还原产物的酸碱处理及加热条件，保留阳性对照。碘阳性与还原检验阳性并存支持部分水解；两检验均阴性先排除温度、碱、试剂和检出限，不当作“完全水解”组合。",
          "block_indices": [
            73,
            75,
            77,
            79,
            80,
            148,
            169,
            178,
            180
          ]
        },
        {
          "summary": "写油脂水解式先数酯键再定产物：1mol三酯充分皂化需3mol NaOH，得到1mol甘油及共3mol高级脂肪酸钠。硬脂酸甘油酯＋3NaOH（加热）→3C₁₇H₃₅COONa＋HOCH₂CH(OH)CH₂OH；分别标硬脂酸钠、甘油，混合残基应逐项写盐。",
          "block_indices": [
            229,
            231,
            248,
            250,
            302,
            303
          ]
        },
        {
          "summary": "比较酯化、水解和氢化时沿具体官能团追踪变化：酯化核羟基与羧基数、脱水数量；水解核酯键和酸碱产物；氢化核C=C数与H₂系数。溴水褪色须排除其他作用，不能以植物或动物来源单独替代结构证据。",
          "block_indices": [
            48,
            52,
            231,
            248,
            250,
            252,
            254,
            259,
            270
          ]
        },
        {
          "summary": "人工淀粉流程先读图中原料、催化条件与箭头，再按官能团和元素守恒解释。速率比较统一mol·h⁻¹·g⁻¹：题给每克4h产5.28×10⁻³mol，应先除以4，再除以1.548×10⁻⁴，约8.5；该数是给定题设的运算，不认证原论文实验效率或淀粉摩尔质量口径。",
          "block_indices": [
            129,
            213,
            219,
            221,
            224
          ]
        }
      ],
      "pitfalls": [
        {
          "summary": "52区块把葡萄糖写成与5份乙酸酯化、失5H₂O，产物却只改了一个羟基且仍保留4个CHOH；阅读副本第5页同样如此。产物表达与计量不符，保留原式待核；备课时逐一核五个羟基，不沿用该印刷产物或暗改后声称原式正确。",
          "block_indices": [
            48,
            52
          ]
        },
        {
          "summary": "269区块把甘油写成C₃H₈O₂，302旧式预览写C₃H₈O₃，教材结构有三个羟基，正确为C₃H₈O₃。巧克力混合物口感不能证明纯硬脂酸甘油酯熔点很低；本次不补造熔点数值，也不据来源答案认证此物性解释。",
          "block_indices": [
            269,
            270,
            302,
            303
          ]
        },
        {
          "summary": "232把三个R相同的三酯称“单甘油酯”，容易与仅一个羟基被酯化的单酰甘油混淆。图231实际仍有三个酯基，教材用三个残基相同或不同表达。234“天然油脂都是多种混甘油酯”也过于绝对，应分清单分子残基与样品混合物。",
          "block_indices": [
            231,
            232,
            233,
            234
          ]
        },
        {
          "summary": "259泛称天然油脂分子都含C=C，与饱和硬脂酸甘油酯结构冲突；252凭溴水把植物油与动物油绝对区分，证据也不足。用结构中有无双键限定氢化、加成和褪色，酯基不因此消失，不按产地或来源种类推断全部分子。",
          "block_indices": [
            252,
            254,
            259,
            270,
            303
          ]
        },
        {
          "summary": "169用“碘易升华”解释水解液冷却检验，教材说明加热会影响淀粉碘显色；不能把固体升华直接当溶液显色机制。77、180、202的阴性结论还需排除碱、温度和试剂失效；还原检验阳性只证还原性产物，不单独证明完全水解。",
          "block_indices": [
            77,
            79,
            80,
            169,
            178,
            180,
            202
          ]
        },
        {
          "summary": "171把唾液淀粉酶作用直接写成生成葡萄糖，忽略麦芽糖等中间水解产物。教材麦芽糖也属于还原糖，出现银镜或砖红色沉淀不足以特异确认葡萄糖，更不能把酶促过程的一次阳性等同于完全水解。",
          "block_indices": [
            59,
            62,
            73,
            171
          ]
        },
        {
          "summary": "69、102仅用“n不同”证明淀粉与纤维素不是同分异构体，不能作为充分通则。同一重复单元表示式未给出完整分子式或连接结构，实际聚合物样品还有分子量分布；教材依据是连接方式与宏观性质，不能只凭通式判断结构相同。",
          "block_indices": [
            65,
            69,
            102
          ]
        },
        {
          "summary": "84、86、91把新制Cu(OH)₂实验直接用于病人尿糖解释；本次只采用有条件的还原性检验，阳性不特异证明葡萄糖、也不作诊断。312、316、321的“医用胶无毒无害”和502用途未核，只可按题给结构讨论聚合，不作为健康或伤口处理建议。",
          "block_indices": [
            84,
            86,
            91,
            312,
            316,
            321
          ]
        }
      ],
      "teaching_flow": [
        {
          "summary": "建议40分钟：5分钟按水解能力分类糖；10分钟比较葡萄糖、果糖链状式与教材环链说明；15分钟为淀粉水解设计两份取样，检查冷却、酸碱和阳性对照；10分钟用“阳性不特异、阴性需排干扰”解释讲义表格。时间与评分点为备课建议。",
          "block_indices": [
            48,
