    {
      "id": "READ-20261005-CHLORINE-03",
      "title": "把电解食盐水的产物对应到电极",
      "volume_id": "TB-M1",
      "section_key": "TB-M1-C2:2.1",
      "pdf_pages": [
        49,
        50
      ],
      "printed_pages": [
        44,
        45
      ],
      "summary": "教材讨论电解饱和食盐水：阳极生成氯气，阴极生成氢气，溶液中得到氢氧化钠。氯化钠与水在通电条件下的总反应为2NaCl+2H₂O→2NaOH+H₂↑+Cl₂↑。",
      "classroom_check": "在纸上标出电源正负极与电极，再把产物、电极反应和总反应对应起来，检查元素及电荷守恒。",
      "limitation": "箭头的条件为通电；总结限定于教材本页的饱和食盐水体系，不能直接推广到任意盐溶液。",
      "source_path": "课本/沪科技化学必修第一册【高清教材】.pdf",
