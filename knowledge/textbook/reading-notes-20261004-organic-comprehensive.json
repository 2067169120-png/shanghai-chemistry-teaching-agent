    {
      "id": "READ-20261004-ORGANIC-COMPREHENSIVE-02",
      "title": "色谱中的移动差异",
      "volume_id": "TB-E3",
      "section_key": "TB-E3-C5:5.2",
      "pdf_pages": [
        115,
        116
      ],
      "printed_pages": [
