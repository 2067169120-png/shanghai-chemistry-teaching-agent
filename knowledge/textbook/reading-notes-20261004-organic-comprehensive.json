    {
      "id": "READ-20261004-ORGANIC-COMPREHENSIVE-03",
      "title": "燃烧分析先求组成比例",
      "volume_id": "TB-E3",
      "section_key": "TB-E3-C5:5.2",
      "pdf_pages": [
        116,
        117
      ],
      "printed_pages": [
        112,
        113
      ],
      "source_anchors": [
        "燃烧分析先求组成比例"
      ],
      "summary": "教材含C、H、O样品燃烧后由水和二氧化碳的质量确定氢、碳，再按样品总质量核氧，得到实验式。实验式是最简原子数比，结合相对分子质量才能进一步确定分子式。",
      "classroom_check": "沿0.90 g样品、0.54 g水和1.32 g二氧化碳的数据列质量与原子数账，说明仍缺哪个量才能确定分子式。",
      "limitation": "仅用于题给只含C、H、O且收集关系完整的模型；不把实验式CH2O直接写成唯一分子式，计算属于备课推导。",
      "textbook_evidence": {
        "source_sha256": "26ccd86648c807476fd6f08db7e414571fa0d5e077db63b15c9880cb225cd137",
        "pdf_pages": [
