    {
      "id": "READ-20261005-AROMATIC-05",
      "title": "苯的硝化是取代，硝基苯颜色须连同脚注读",
      "volume_id": "TB-E3",
      "section_key": "TB-E3-C2:2.2",
      "pdf_pages": [
        36,
        37
