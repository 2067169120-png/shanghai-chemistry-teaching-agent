      "publication_allowed": false
    },
    {
      "id": "READ-20261005-ATOM-03",
      "title": "原子质量主要集中在原子核",
      "volume_id": "TB-M1",
      "section_key": "TB-M1-C4:4.2",
      "pdf_pages": [
        124
      ],
      "printed_pages": [
        119
      ],
      "summary": "原页列出质子、中子和电子的质量，质子与中子的质量远大于电子。教材因此说明原子的质量主要由原子核决定；微粒的实际质量以kg表示，和核素符号中的质量数属于不同量。",
      "classroom_check": "比较原表三种微粒的质量数量级，写清物理量与单位，解释“质量主要集中在核内”支持的判断。",
      "limitation": "不把近似比较当成各微粒质量完全相等，不把质量数直接附上kg。",
      "source_path": "课本/沪科技化学必修第一册【高清教材】.pdf",
      "source_sha256": "a565f0a15ffd10c704f4be42bfe7200c125b68959d11ef582acdc45dde2ccf22",
