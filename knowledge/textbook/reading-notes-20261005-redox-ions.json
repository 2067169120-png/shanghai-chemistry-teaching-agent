    {
      "id": "READ-20261005-REDOX-IONS-04",
      "title": "电解质分类先限定对象和状态",
      "volume_id": "TB-M1",
      "section_key": "TB-M1-C2:2.2",
      "pdf_pages": [
        61
      ],
      "printed_pages": [
        56
      ],
      "summary": "教材比较固体、水溶液和熔融状态的导电情况。电解质与非电解质的分类对象是化合物；观察到某种溶液导电，需要进一步说明其中自由移动离子的来源。",
      "classroom_check": "把“物质本身是什么”“观察的是哪种状态”“是否存在自由移动离子”分成三个问题逐项回答。",
      "limitation": "导电现象与物质分类不能只靠一个名称对应；混合溶液和金属不能直接套用化合物的电解质分类。",
      "source_path": "课本/沪科技化学必修第一册【高清教材】.pdf",
