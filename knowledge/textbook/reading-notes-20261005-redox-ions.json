    {
      "id": "READ-20261005-REDOX-IONS-06",
      "title": "区分强弱电解质并保留可逆符号",
      "volume_id": "TB-M1",
      "section_key": "TB-M1-C2:2.2",
      "pdf_pages": [
        62,
        63
      ],
      "printed_pages": [
        57,
        58
      ],
      "summary": "教材把在水溶液中全部电离的电解质与部分电离的电解质区分。醋酸的电离写为CH₃COOH⇌H⁺+CH₃COO⁻，一水合氨写为NH₃·H₂O⇌NH₄⁺+OH⁻，均保留可逆符号。",
      "classroom_check": "让学生比较盐酸、醋酸和一水合氨的电离表示，检查箭头、下标及两侧总电荷。",
      "limitation": "强弱分类描述电离程度，不直接等同于某份溶液浓度大小或导电强弱；教材把水列为极弱电解质。",
      "source_path": "课本/沪科技化学必修第一册【高清教材】.pdf",
