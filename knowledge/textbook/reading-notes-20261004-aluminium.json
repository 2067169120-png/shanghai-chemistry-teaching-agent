    {
      "id": "READ-20261004-ALUMINIUM-02",
      "title": "浓酸钝化需要物质、浓度和温度条件",
      "volume_id": "TB-M2",
      "section_key": "TB-M2-C5:5.1",
      "pdf_pages": [
