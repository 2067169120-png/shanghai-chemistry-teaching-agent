    {
      "id": "READ-20261005-MOLE-04",
      "title": "摩尔质量要带单位",
      "volume_id": "TB-M1",
      "section_key": "TB-M1-C1:1.2",
      "pdf_pages": [
        21,
        22
      ],
      "printed_pages": [
        16,
        17
      ],
      "summary": "摩尔质量M描述每摩尔指定物质的质量。以g·mol⁻¹表示时，常见物质的M在数值上可与相对原子质量或相对分子质量对应；二者的含义和单位仍需区分。",
      "classroom_check": "把铁、乙醇的相对质量与摩尔质量并列，让学生补单位，再用n=m/M核对单位约去的过程。",
      "limitation": "相对质量无量纲；写出M时要注明所指物质和单位，m与M使用一致的质量单位。",
      "source_path": "课本/沪科技化学必修第一册【高清教材】.pdf",
      "source_sha256": "a565f0a15ffd10c704f4be42bfe7200c125b68959d11ef582acdc45dde2ccf22",
      "textbook_evidence": {
        "source_sha256": "a565f0a15ffd10c704f4be42bfe7200c125b68959d11ef582acdc45dde2ccf22",
        "pdf_pages": [
          21,
