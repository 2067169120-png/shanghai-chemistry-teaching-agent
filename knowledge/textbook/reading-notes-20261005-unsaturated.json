    {
      "id": "READ-20261005-UNSATURATED-04",
      "title": "电石制乙炔保留反应物、条件和气体符号",
      "volume_id": "TB-M2",
      "section_key": "TB-M2-C7:7.2",
      "pdf_pages": [
        87
