    {
      "id": "READ-TB-M1-20260926-SEP-01",
      "title": "分离后该保留哪一相？",
      "volume_id": "TB-M1",
      "section_key": "TB-M1-C1:1.3",
      "pdf_pages": [
        29,
        38
      ],
      "printed_pages": [
        24,
        33
      ],
      "lecture_package_id": "PKG-038",
      "lecture_block_indices": [
