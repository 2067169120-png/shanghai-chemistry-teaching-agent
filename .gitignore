# Track software deliberately; local teaching evidence is not a Git artifact.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/AGENTS.md
!/integrations/
!/staging/
/staging/*
!/staging/coordination/
/staging/coordination/*
!/staging/coordination/deeptutor_gateway/
/staging/coordination/deeptutor_gateway/*
!/staging/coordination/deeptutor_gateway/tests/
!/staging/coordination/deeptutor_gateway/contracts/
!/staging/coordination/deeptutor_gateway/scripts/
!/staging/coordination/deeptutor_gateway/fixtures/
/staging/coordination/deeptutor_gateway/fixtures/*
!/staging/coordination/deeptutor_gateway/fixtures/mock_gateway_v1.json
!/staging/coordination/deeptutor_gateway/fixtures/retired_r5_chain_v1.json
!/runtime/
/runtime/*
!/runtime/deeptutor_shchem/
/runtime/deeptutor_shchem/*
!/runtime/deeptutor_shchem/desktop_teacher_workbench.pyw
!/runtime/deeptutor_shchem/close_desktop_workbench.pyw
!/runtime/deeptutor_shchem/desktop_build.ps1
!/runtime/deeptutor_shchem/desktop_requirements.txt
!/runtime/deeptutor_shchem/verify_desktop_package.ps1
!/打开沪上化学智研台（无窗口）.vbs
!/关闭沪上化学智研台（无窗口）.vbs
!/启动沪上化学智研台桌面版.vbs
!/关闭沪上化学智研台桌面版.vbs
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.runtime/
**/.venv*/
**/node_modules/
**/*.pyc
**/*.pyd
**/*.dll
**/*.exe
**/*.zip
**/*.log
**/.env
**/.env.*
**/*personal*.json
**/private_state*/
**/private_student_domain/
**/*secret*
**/*credential*
